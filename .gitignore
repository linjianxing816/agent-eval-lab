# 密钥（不进 git）
.env

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# 运行产物：默认全不传（体积大、可重新生成）
results/*
# 例外：简历/README 上每个数字的原始依据，必须能被验证
# check_all_old.txt  23 条坏题的命中明细（旧版任务文件）
# check_all.txt      修完 6 条后的中间态（17 条）
# audit_s2.json      100% 可执行 / 93.3% 判定一致率
# compare_fix.json   修前修后通过率
# d8_run.log         93.3% 的逐任务判定记录
# concurrency*.json  4 档并发 sweep + 420 次压测
# d26_*.jsonl        修后 A/B 各 90 次原始轨迹
# report_data.json   报告页数据源 + README 每个数字的原始依据；平台 2 条接口测试要用它，
#                    且 CI 里没法重新生成（14 个批次大部分不入库），所以必须进 git
!results/check_all_old.txt
!results/check_all.txt
!results/audit_s2.json
!results/compare_fix.json
!results/d8_run.log
!results/concurrency.json
!results/concurrency_426.json
!results/d26_modela.jsonl
!results/d26_modelb.jsonl
!results/d26_a_run.log
!results/d26_b_run.log
!results/report_data.json

# 编辑器
.vscode/
.idea/
.DS_Store
