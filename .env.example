# 复制为 .env，填真实值。.env 已在 .gitignore 里，不会提交。
#
# 【关键】AI_BASE_URL 填到「拼上 /chat/completions 就能用」的那一层。
# 代码只会做 base_url.rstrip('/') + '/chat/completions'，不会替你补 /v1。
# 不同厂商层级不同，照下面抄：
#
#   DeepSeek     https://api.deepseek.com
#   OpenAI       https://api.openai.com/v1
#   通义 / 百炼   https://dashscope.aliyuncs.com/compatible-mode/v1
#   月之暗面      https://api.moonshot.cn/v1
#
# 填错的表现：404 或 invalid url。先 curl 试通，再写进 .env。

AI_BASE_URL=https://api.deepseek.com

# 被测模型 A/B 用的 key
AI_API_KEY=sk-在这里填你的key

# 被测模型 A/B 的模型名
AI_MODEL=deepseek-chat

# 第三个被测对象（D11 用，可以先空着）
# BASE_URL 的层级规则同上——通义那类必须带 /v1
MODEL_B_BASE_URL=
MODEL_B_API_KEY=
MODEL_B_MODEL=

# 区分度实验用的参考 prompt（不用改，指到 prompts/ 下）
STRONG_PROMPT=prompts/v2.txt
WEAK_PROMPT=prompts/v1.txt

# 单价不配了：2026-10-25 起报告只报 token，不报金额。
# 原因：峰谷定价（工作日 9-12 / 14-18 双倍）+ 缓存命中率（未命中约 3 元/百万、
# 命中约 0.025 元/百万）都会让同一批实验算出不同金额，复现不出同一个数。

# 存储层（第二阶段）。**不配也能跑**：默认 SQLite，文件落在 results/evalkit.db。
# 配了 postgresql:// 就走 PG，schema 和查询都是方言无关的（SQLAlchemy Core）。
# 用 PG 要额外装驱动：pip install "psycopg[binary]"
# DATABASE_URL=sqlite:///results/evalkit.db
# DATABASE_URL=postgresql://evalkit:evalkit@localhost:5432/evalkit
